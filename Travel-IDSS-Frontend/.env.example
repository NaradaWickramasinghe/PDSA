# Travel-IDSS Frontend Environment Variables (Example)
# Copy this file to .env and fill in the values

# API Base URL - Spring Boot Backend
VITE_API_BASE_URL=http://localhost:8080/api

# Application Settings
VITE_APP_NAME=Travel IDSS
VITE_APP_VERSION=1.0.0

# Map Configuration
VITE_MAP_API_KEY=your_map_api_key_here

# Feature Flags
VITE_ENABLE_NETWORK_ANALYSIS=true
VITE_ENABLE_DECISION_SUPPORT=true
VITE_ENABLE_OPTIMIZATION=true
